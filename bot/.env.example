TELEGRAM_BOT_TOKEN=

# Opcional: lista de IDs de Telegram autorizados a usar el bot, separados por coma.
# Si se deja vacío, el bot queda abierto para cualquiera (comportamiento por defecto).
TELEGRAM_ALLOWED_IDS=

# Opcional: lista de IDs de Telegram con permiso para usar /actualizar, separados por coma.
TELEGRAM_ADMIN_IDS=

# Opcional: chat/canal donde se publican las notificaciones de /actualizar.
TELEGRAM_NOTIFY_CHAT_ID=

# Opcional: carpeta donde se guarda el estado vivo (state.json). En Railway,
# apunta esto a un Volume (ej. /data) para que los datos sobrevivan a los
# redeploys. Si no se define, usa ./.data dentro de esta carpeta.
DATA_DIR=
